{
  "name": "flamingo",
  "version": "1.0.0",
  "description": "A tscircuit component package",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "bun scripts/prepare-preview-runtime.mjs && RUNFRAME_STANDALONE_FILE_PATH=.tscircuit/preview-runtime.min.js tsci dev index.circuit.tsx",
    "build": "tsci build index.circuit.tsx --disable-parts-engine --inject-props '{\"preview\":false}'",
    "build:supplier": "tsci build index.circuit.tsx --inject-props '{\"preview\":false}'",
    "check:drc": "bun scripts/validate-board.mjs --scope=drc",
    "check:drc:routed": "bun scripts/validate-board.mjs --scope=drc --require-routed",
    "sim:setup": "bun scripts/setup-spice.mjs",
    "sim:power-reset": "bun scripts/simulate-power-reset.jsx",
    "sim:check": "bun scripts/simulate-power-reset.jsx --check",
    "audit:schematic": "bun run build:json && bun scripts/audit-schematic.mjs",
    "push": "tsci push",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "bun run dev",
    "typecheck": "tsc --noEmit",
    "check:bga": "bun scripts/review-bridge-bga.jsx",
    "check:slot-power": "bun scripts/check-slot-power.mjs",
    "sim:slot-driver": "bun scripts/simulate-slot-driver.jsx",
    "sim:slot-startup": "bun simulations/slot-power/check-capacitor-startup.mjs && bun simulations/slot-power/validate-capacitor-model.mjs",
    "check:usb4": "bun scripts/validate-board.mjs --scope=usb",
    "check:usb": "bun scripts/validate-board.mjs --scope=usb",
    "check:pcie-tx": "bun scripts/validate-board.mjs --scope=pcie",
    "check:pcie-rx": "bun scripts/validate-board.mjs --scope=pcie",
    "check:pcie": "bun scripts/validate-board.mjs --scope=pcie",
    "check:clocks": "bun scripts/validate-board.mjs --scope=clocks",
    "check:bucks": "bun scripts/validate-board.mjs --scope=bucks",
    "check:pdn": "bun scripts/validate-board.mjs --scope=pdn",
    "check:vcch": "bun scripts/validate-board.mjs --scope=vcch",
    "check:atx5v": "bun scripts/validate-board.mjs --scope=atx5v",
    "check:slot-routing": "bun scripts/validate-board.mjs --scope=slot",
    "check:vbus": "bun scripts/validate-board.mjs --scope=vbus",
    "check:grounds": "bun scripts/validate-board.mjs --scope=grounds",
    "setup:controls": "bun scripts/prepare-control-routing.mjs",
    "route:controls": "bun scripts/solve-control-routing.mjs",
    "check:controls:native": "bun scripts/route-control-board.mjs",
    "route:controls:native": "bun scripts/route-control-board.mjs --route",
    "check:controls": "bun scripts/check-control-routing.mjs",
    "test:controls": "CONTROL_ROUTING_FIXTURE=dist/control-routing/input.json bun test tests/control-routing.test.mjs",
    "check:board": "bun scripts/validate-board.mjs",
    "build:json": "bun scripts/build-board.mjs",
    "test": "bun run build:json && bun test ./tests --timeout 120000"
  },
  "devDependencies": {
    "@tscircuit/checks": "0.0.247",
    "@tscircuit/ngspice-spice-engine": "0.0.20",
    "@types/react": "^19.3.0",
    "spicets": "0.0.4",
    "tscircuit": "^0.0.2832",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@tscircuit/circuit-json-util": "0.0.119",
    "@tscircuit/footprinter": "0.0.431",
    "@tscircuit/math-utils": "^0.0.38"
  },
  "patchedDependencies": {
    "@tscircuit/core@0.0.2131": "patches/@tscircuit%2Fcore@0.0.2131.patch"
  }
}
