{
  "name": "flamingo",
  "version": "1.0.0",
  "description": "A tscircuit component package",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "bun scripts/dev-preview.mjs",
    "dev:full": "tsci dev",
    "profile:3d": "node scripts/profile-3d-viewer.mjs",
    "build": "tsci build index.circuit.tsx --disable-parts-engine",
    "build:supplier": "tsci build index.circuit.tsx",
    "check:drc": "bun scripts/check-jlcpcb.mjs",
    "check:drc:routed": "bun scripts/check-jlcpcb.mjs --require-routed",
    "sim:setup": "bun scripts/setup-spice.mjs",
    "sim:power-reset": "bun scripts/simulate-power-reset.jsx",
    "sim:check": "bun scripts/simulate-power-reset.jsx --check",
    "audit:schematic": "tsci build index.circuit.tsx --disable-parts-engine && bun scripts/audit-schematic.mjs",
    "push": "tsci push",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "bun scripts/dev-preview.mjs",
    "typecheck": "tsc --noEmit",
    "check:bga": "bun scripts/review-bridge-bga.jsx",
    "check:slot-power": "bun scripts/check-slot-power.mjs",
    "sim:slot-driver": "bun scripts/simulate-slot-driver.jsx",
    "check:usb4": "bun scripts/build-usb4-routing.mjs",
    "check:usb": "bun scripts/check-usb.mjs",
    "check:pcie-tx": "bun scripts/check-pcie-tx-routing.mjs",
    "check:pcie-rx": "bun scripts/check-pcie-rx-routing.mjs",
    "check:pcie": "bun scripts/check-pcie.mjs",
    "check:clocks": "bun scripts/check-bridge-clocks.mjs",
    "check:bucks": "bun scripts/check-buck-routing.mjs",
    "check:pdn": "bun scripts/check-power-distribution.mjs",
    "check:vcch": "bun scripts/check-vcch-routing.mjs",
    "check:atx5v": "bun scripts/check-atx5v-routing.mjs",
    "check:slot-routing": "bun scripts/check-slot-routing.mjs",
    "check:vbus": "bun scripts/check-vbus-routing.mjs",
    "check:grounds": "bun scripts/check-ground-returns.mjs"
  },
  "devDependencies": {
    "@tscircuit/checks": "0.0.247",
    "@tscircuit/ngspice-spice-engine": "0.0.20",
    "@types/react": "^19.3.0",
    "spicets": "0.0.4",
    "tscircuit": "^0.0.2832",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@tscircuit/circuit-json-util": "0.0.119",
    "@tscircuit/footprinter": "0.0.431",
    "@tscircuit/math-utils": "^0.0.38"
  },
  "patchedDependencies": {
    "@tscircuit/core@0.0.2131": "patches/@tscircuit%2Fcore@0.0.2131.patch"
  }
}
