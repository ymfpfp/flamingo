{
  "name": "flamingo",
  "version": "1.0.0",
  "description": "A tscircuit component package",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "check:drc": "bun scripts/check-jlcpcb.mjs",
    "check:drc:routed": "bun scripts/check-jlcpcb.mjs --require-routed",
    "push": "tsci push",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tscircuit/checks": "0.0.247",
    "@types/react": "^19.3.0",
    "tscircuit": "^0.0.2823",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@tscircuit/math-utils": "^0.0.38"
  },
  "patchedDependencies": {
    "@tscircuit/core@0.0.2128": "patches/@tscircuit%2Fcore@0.0.2128.patch"
  }
}
