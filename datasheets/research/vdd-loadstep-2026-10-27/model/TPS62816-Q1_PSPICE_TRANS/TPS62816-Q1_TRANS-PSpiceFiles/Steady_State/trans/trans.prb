MAJORSTYLE LINES
MAJORPATTERN SOLID
MINORSTYLE NONE
END GRIDS
BEGIN TRACE V(VOUT)
MARKERID 7
END TRACE V(VOUT)
END YAXIS 1
END ANAPLOT 1
